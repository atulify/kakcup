{
  "name": "kakcup",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"cargo run --bin local-api\" \"vite\"",
    "build": "node scripts/inject-sw-version.js && vite build && cargo build --release --bin local-api",
    "start": "./target/release/local-api",
    "check": "tsc",
    "db:init": ": \"${DATABASE_URL:?Set DATABASE_URL}\" && psql \"$DATABASE_URL\" -X -v ON_ERROR_STOP=1 -1 -f migrations/0000_petite_sharon_ventura.sql",
    "db:seed-kaks": ": \"${DATABASE_URL:?Set DATABASE_URL}\" && psql \"$DATABASE_URL\" -X -v ON_ERROR_STOP=1 -f rust-backend/seed-kaks.sql",
    "vercel-build": "node scripts/inject-sw-version.js && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tanstack/react-query": "^5.60.5",
    "@vercel/speed-insights": "^1.3.1",
    "concurrently": "^9.2.1",
    "preact": "^10.28.4",
    "wouter": "^3.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "cssnano": "^7.1.3",
    "cssnano-preset-advanced": "^7.0.11",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}

# Local PostgreSQL database; export these variables before starting the Rust API.
DATABASE_URL=postgresql://user:password@localhost:5432/kakcup
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Optional local API port (defaults to 3000).
# PORT=3000

# Optional Upstash Redis cache. Set both values to enable it.
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token
# KAKCUP_CACHE_PREFIX=kakcup-local:

# TEST_DATABASE_URL must point to a disposable PostgreSQL database, not DATABASE_URL.
# TEST_DATABASE_URL=postgresql://user:password@localhost:5432/kakcup_test
